{
  "openapi": "3.1.0",
  "info": {
    "title": "LUMII IoT device API",
    "version": "1.0.0",
    "description": "The external API used by a paired LUMII ESP32 desk companion."
  },
  "servers": [
    {
      "url": "https://lumii-kappa.vercel.app",
      "description": "Production"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/api/device/pair": {
      "post": {
        "summary": "Pair a device",
        "operationId": "pairDevice",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairDeviceRequest"
              },
              "example": {
                "pairingCode": "12345678"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device paired",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "private, no-store, max-age=0"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairDeviceResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/device/status": {
      "get": {
        "summary": "Read device status and events",
        "operationId": "getDeviceStatus",
        "security": [
          {
            "deviceBearer": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The latest event cursor saved by the device.",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current device status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceStatus"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/device/config": {
      "get": {
        "summary": "Read device configuration",
        "operationId": "getDeviceConfig",
        "security": [
          {
            "deviceBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current device configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceConfig"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/device/unpair": {
      "post": {
        "summary": "Unpair an owned device",
        "operationId": "unpairDevice",
        "security": [
          {
            "clerkSession": []
          }
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Must match the origin of the requested LUMII deployment.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnpairDeviceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device token revoked",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["success"],
                  "properties": {
                    "success": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "deviceBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The opaque device token returned once during pairing."
      },
      "clerkSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__session",
        "description": "The signed-in web session. Firmware does not use this."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request or event cursor is invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication is missing, invalid, or revoked.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The browser request origin is not allowed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "The owned device does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "The account already has three active devices.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "The JSON request body is larger than the allowed limit.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Too many pairing attempts.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unavailable": {
        "description": "The device API is disabled or temporarily unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "PairDeviceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pairingCode"],
        "properties": {
          "pairingCode": {
            "type": "string",
            "pattern": "^[0-9]{8}$"
          }
        }
      },
      "PairDeviceResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apiVersion", "deviceId", "deviceToken", "eventCursor"],
        "properties": {
          "apiVersion": {
            "const": "1"
          },
          "deviceId": {
            "type": "string"
          },
          "deviceToken": {
            "type": "string"
          },
          "eventCursor": {
            "type": "string"
          }
        }
      },
      "UnpairDeviceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deviceId"],
        "properties": {
          "deviceId": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "ActiveSession": {
        "type": ["object", "null"],
        "required": ["id", "startedAt", "elapsedSec"],
        "properties": {
          "id": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "elapsedSec": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "UpcomingReminder": {
        "type": ["object", "null"],
        "required": ["id", "title", "plannedStart"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "plannedStart": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeviceEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/RankUpEvent"
          },
          {
            "$ref": "#/components/schemas/TrophyUnlockedEvent"
          },
          {
            "$ref": "#/components/schemas/QuizCompletedEvent"
          },
          {
            "$ref": "#/components/schemas/DayEvent"
          }
        ],
        "discriminator": {
          "propertyName": "type"
        }
      },
      "EventBase": {
        "type": "object",
        "required": ["id", "type", "occurredAt", "data"],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "RankUpEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventBase"
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "rank_up"
              },
              "data": {
                "type": "object",
                "required": ["fromRank", "toRank"],
                "properties": {
                  "fromRank": {
                    "type": "string"
                  },
                  "toRank": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      },
      "TrophyUnlockedEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventBase"
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "trophy_unlocked"
              },
              "data": {
                "type": "object",
                "required": ["code"],
                "properties": {
                  "code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      },
      "QuizCompletedEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventBase"
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "quiz_completed"
              },
              "data": {
                "type": "object",
                "required": [
                  "correctCount",
                  "questionCount",
                  "scorePercent",
                  "perfect"
                ],
                "properties": {
                  "correctCount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "questionCount": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "scorePercent": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "perfect": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        ]
      },
      "DayEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventBase"
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "enum": ["adherent_day", "perfect_day"]
              },
              "data": {
                "type": "object",
                "required": ["localDate"],
                "properties": {
                  "localDate": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  }
                }
              }
            }
          }
        ]
      },
      "DeviceStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "deviceId",
          "serverTime",
          "rank",
          "totalXp",
          "currentStreak",
          "activeSession",
          "rankUp",
          "upcomingReminder",
          "moodCheckinNeeded",
          "events",
          "nextCursor",
          "hasMore"
        ],
        "properties": {
          "apiVersion": {
            "const": "1"
          },
          "deviceId": {
            "type": "string"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          },
          "rank": {
            "enum": ["BRONZE", "SILVER", "GOLD", "PLATINUM", "DIAMOND"]
          },
          "totalXp": {
            "type": "integer",
            "minimum": 0
          },
          "currentStreak": {
            "type": "integer",
            "minimum": 0
          },
          "activeSession": {
            "$ref": "#/components/schemas/ActiveSession"
          },
          "rankUp": {
            "type": "boolean"
          },
          "upcomingReminder": {
            "$ref": "#/components/schemas/UpcomingReminder"
          },
          "moodCheckinNeeded": {
            "type": "boolean"
          },
          "events": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/DeviceEvent"
            }
          },
          "nextCursor": {
            "type": "string"
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "DeviceConfig": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "deviceId",
          "serverTime",
          "pollIntervalSec",
          "brightness",
          "volume",
          "moodNudgeEnabled",
          "updatedAt"
        ],
        "properties": {
          "apiVersion": {
            "const": "1"
          },
          "deviceId": {
            "type": "string"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          },
          "pollIntervalSec": {
            "const": 8
          },
          "brightness": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "volume": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "moodNudgeEnabled": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apiVersion", "error"],
        "properties": {
          "apiVersion": {
            "const": "1"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
